# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY: credenciales del proyecto de
# Supabase (radioayudas-dev). La anon key es pública por diseño (Supabase la
# protege con Row Level Security), pero igual no se commitea el .env real.
# Configurar estas mismas variables en Vercel (Project Settings > Environment
# Variables) para que el deploy en la web se conecte a la misma base.
VITE_SUPABASE_URL="https://xxxxxxxx.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"
